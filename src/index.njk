---
layout: base.njk
title: Elena Bulatova Portfolio
---
<header>
  <div class="topnav">
    <h3><a href="/about/" class="mincho-link">About &amp; Contact</a></h3>
    <h3><a href="{{ site.instagram }}" class="mincho-link" target="_blank" rel="noopener">My Instagram</a></h3>
  </div>
  <h1>Elena Bulatova</h1>
</header>

<main class="gallery">
  <div class="selector">
    <h2 id="tab-oil" class="active" data-tab="oil">Oil on Canvas</h2>
    <h2 id="tab-graphic" data-tab="graphic">Graphic Works</h2>
  </div>

  <div id="sections-container">
    {% for group in [{ id: "oil", label: "Oil on Canvas" }, { id: "graphic", label: "Graphic Works" }] %}
    <div id="{{ group.id }}" class="artwork-section">
      <h2>{{ group.label }}</h2>
      <img src="/images/temp_separator.jpg" alt="" class="separator">
      <div class="artwork-group">
        {% for art in artworks.items %}{% if art.section == group.id %}
        <section class="artwork">
          <img src="{{ art.image }}" alt="{{ art.name }}" loading="lazy">
          <h3>{{ art.name }}</h3>
          <p>{{ art.details }}</p>
          {% if art.series %}<strong>{{ art.series }}</strong>{% endif %}
          {% if art.description %}{{ art.description | markdown | safe }}{% endif %}
          {% if art.buy_link %}<p><a class="buy" href="{{ art.buy_link }}" target="_blank" rel="noopener">Buy this painting</a></p>{% endif %}
        </section>
        {% endif %}{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</main>

<div id="lightbox-modal" hidden>
  <img id="lightbox-img" src="" alt="Expanded artwork">
</div>

<script>
  const container = document.getElementById('sections-container');

  function showSection(which) {
    document.querySelectorAll('.selector h2').forEach(tab => {
      tab.classList.toggle('active', tab.dataset.tab === which);
    });
    // reorder rather than hide, so both sections stay indexable and linkable
    const chosen = document.getElementById(which);
    if (chosen) container.prepend(chosen);
  }

  document.querySelectorAll('.selector h2').forEach(tab => {
    tab.addEventListener('click', () => showSection(tab.dataset.tab));
  });

  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img');

  document.querySelectorAll('.artwork img').forEach(img => {
    img.addEventListener('click', () => {
      modalImg.src = img.src;
      modal.hidden = false;
    });
  });

  function closeLightbox() {
    modal.hidden = true;
    modalImg.src = '';
  }

  modal.addEventListener('click', e => { if (e.target === modal) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) closeLightbox(); });
</script>
