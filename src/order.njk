---
layout: base.njk
title: Commissions — Elena Bulatova
permalink: /order/
---
<header>
  <h1 class="commission-title">Commissions</h1>
</header>

<main class="commission">
  <section class="commission-intro">
    {{ site.commission_intro | markdown | safe }}
  </section>

  <p class="price-floor">{{ site.commission_price_line }}</p>

  <section class="process">
    {{ site.commission_process | markdown | safe }}
  </section>

  {% if commissions.items.length %}
  <section class="samples">
    <h2>Previous commissions</h2>
    <img src="/images/temp_separator.jpg" alt="" class="separator">
    <div class="artwork-group">
      {% for c in commissions.items %}
      <section class="artwork">
        <img src="{{ c.image }}" alt="{{ c.name }}" loading="lazy">
        <h3>{{ c.name }}</h3>
        {% if c.details %}<p>{{ c.details }}</p>{% endif %}
        {% if c.brief %}{{ c.brief | markdown | safe }}{% endif %}
      </section>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="order">
    <h2>Begin a commission</h2>

    {# posts to FormSubmit, which forwards the request (and any attachment) to site.email #}
    <form method="POST" enctype="multipart/form-data" action="https://formsubmit.co/{{ site.email }}">
      <input type="hidden" name="_subject" value="New commission enquiry from the website">
      <input type="hidden" name="_next" value="https://{{ site.domain }}/order-thanks/">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <p hidden><label>Don't fill this in: <input name="_honey"></label></p>

      <fieldset class="formats">
        <legend>Size</legend>
        {# outlines carry the real proportions AND the real relative scale, so a 120cm
           canvas looks bigger than a 40cm one. 0.72px per cm keeps the row on one line. #}
        {% for f in site.commission_sizes %}
        <label class="format">
          <input type="radio" name="format"
                 value="{{ f.width_cm }} × {{ f.height_cm }} cm — {{ f.price }}"
                 data-price="{{ f.price }}" data-deposit="{{ f.deposit }}"
                 data-link="{{ f.stripe_link }}"{% if loop.first %} checked{% endif %}>
          <span class="canvas" style="aspect-ratio: {{ f.width_cm }} / {{ f.height_cm }}; width: {{ (f.width_cm * 0.72) | round }}px"></span>
          <span class="dims">{{ f.width_cm }} × {{ f.height_cm }} cm</span>
          <span class="price">{{ f.price }}</span>
        </label>
        {% endfor %}

        <label class="format" id="custom-format">
          <input type="radio" name="format" value="Custom size" data-custom="1"
                 data-base="{{ site.commission_custom_base }}"
                 data-rate="{{ site.commission_custom_per_cm2 }}"
                 data-link="{{ site.commission_custom_stripe_link }}">
          {# this outline redraws itself to whatever measurements are typed below #}
          <span class="canvas canvas-open" id="custom-canvas"></span>
          <span class="dims">Custom size</span>
          <span class="price" id="custom-price">&mdash;</span>
        </label>
      </fieldset>

      <div id="custom-fields" hidden>
        <div class="custom-inputs">
          <span>
            <label for="custom-w">Width (cm)</label>
            <input id="custom-w" name="custom_width" type="number" min="20" max="200" step="1" value="70">
          </span>
          <span>
            <label for="custom-h">Height (cm)</label>
            <input id="custom-h" name="custom_height" type="number" min="20" max="200" step="1" value="90">
          </span>
        </div>
        <p class="custom-note">{{ site.commission_custom_note }}</p>
      </div>

      <fieldset class="subjects">
        <legend>Subject</legend>
        {% for s in site.commission_subjects.split("\n") %}
        {% if s | trim %}
        <label class="subject">
          <input type="radio" name="subject" value="{{ s | trim }}"{% if loop.first %} checked{% endif %}> {{ s | trim }}
        </label>
        {% endif %}
        {% endfor %}
      </fieldset>

      <label for="details">What do you have in mind? *</label>
      <textarea id="details" name="details" rows="6" required placeholder="The subject, who it is for, where it will hang, any timing that matters."></textarea>

      <label for="reference">Reference photograph (optional)</label>
      <input id="reference" name="reference" type="file" accept="image/*">

      <label for="name">Your name *</label>
      <input id="name" name="name" type="text" required>

      <label for="email">Email *</label>
      <input id="email" name="email" type="email" required>

      <label for="phone">Telephone (optional)</label>
      <input id="phone" name="phone" type="tel">

      <label class="consent"><input type="checkbox" name="privacy" required> I agree that my data will be used to answer this request. <a href="/datenschutz/" class="mincho-link">Datenschutz</a> *</label>

      {# the withdrawal right is excluded for custom work under § 312g Abs. 2 Nr. 1 BGB,
         but the exclusion only holds if the buyer acknowledges it before paying #}
      <label class="consent"><input type="checkbox" name="widerruf" required> I understand that a painting made to my specification is exempt from the fourteen-day right of withdrawal. <a href="/widerruf/" class="mincho-link">Widerrufsbelehrung</a> *</label>

      <p class="summary">
        <span id="summary-total"></span>
        <span id="summary-split"></span>
      </p>

      <button type="submit" class="button" id="submit-btn">Send request</button>
      <p class="response-time">{{ site.commission_response_time }}</p>
    </form>

    <p class="payment-note">{{ site.commission_payment_note }}</p>
  </section>
</main>

<p><a href="/" class="mincho-link">&larr; Back to Portfolio</a></p>

<script>
  // Sending the form redirects to the Stripe link for the chosen size, so one button
  // does enquiry + payment. Without JS the form still sends and lands on /order-thanks/.
  const nextField = document.querySelector('input[name="_next"]');
  const fallbackNext = nextField.value;
  const total = document.getElementById('summary-total');
  const split = document.getElementById('summary-split');
  const btn = document.getElementById('submit-btn');

  const customRadio = document.querySelector('.format input[data-custom]');
  const customFields = document.getElementById('custom-fields');
  const customCanvas = document.getElementById('custom-canvas');
  const customPrice = document.getElementById('custom-price');
  const wIn = document.getElementById('custom-w');
  const hIn = document.getElementById('custom-h');

  const euro = (n) => '€' + Math.round(n).toLocaleString('en-US');

  // clamped to the input's own min/max so a typo can't produce a €40,000 canvas
  function cm(input) {
    const v = Number(input.value);
    if (!Number.isFinite(v) || v <= 0) return null;
    return Math.min(Math.max(v, Number(input.min)), Number(input.max));
  }

  // price = base + rate per cm², rounded to the nearest €50 so it never looks computed
  function customQuote() {
    const w = cm(wIn), h = cm(hIn);
    if (!w || !h) return null;
    const raw = Number(customRadio.dataset.base) + w * h * Number(customRadio.dataset.rate);
    const price = Math.round(raw / 50) * 50;
    return { w, h, price, deposit: Math.round(price / 2 / 5) * 5 };
  }

  function syncCustom() {
    const q = customQuote();
    customCanvas.style.aspectRatio = q ? `${q.w} / ${q.h}` : '1 / 1';
    customCanvas.style.width = q ? `${Math.round(Math.min(q.w, 120) * 0.72)}px` : '58px';
    customPrice.textContent = q ? euro(q.price) : '—';
    // never leave a stale size on the radio -- that value is what lands in her inbox
    customRadio.value = q
      ? `Custom ${q.w} × ${q.h} cm — ${euro(q.price)}`
      : 'Custom size — measurements not given';
    customRadio.dataset.price = q ? euro(q.price) : '';
    customRadio.dataset.deposit = q ? euro(q.deposit) : '';
  }

  function sync() {
    const chosen = document.querySelector('.format input:checked');
    if (!chosen) return;
    const isCustom = !!chosen.dataset.custom;
    customFields.hidden = !isCustom;
    wIn.required = hIn.required = isCustom;
    if (isCustom) syncCustom();

    const link = chosen.dataset.link;
    const priced = !isCustom || customQuote();
    total.textContent = priced ? chosen.dataset.price : 'Enter both measurements';
    split.textContent = link && priced
      ? `${chosen.dataset.deposit} payable now, the balance on delivery.`
      : 'Payment details follow by email.';
    btn.textContent = link && priced ? `Send request and pay ${chosen.dataset.deposit}` : 'Send request';
    nextField.value = (link && priced) ? link : fallbackNext;
  }

  document.querySelectorAll('.format input').forEach(r => r.addEventListener('change', sync));
  [wIn, hIn].forEach(i => {
    i.addEventListener('input', sync);
    // on blur, show the number actually being quoted rather than what was typed
    i.addEventListener('change', () => {
      const v = cm(i);
      if (v) i.value = v;
      sync();
    });
  });
  syncCustom();
  sync();
</script>
